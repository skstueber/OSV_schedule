Sub ExportSchedule()
    Dim ws As Worksheet
    Dim rngDates As Range, rngJobs As Range
    Dim lastCol As Long, lastRow As Long
    Dim dict As Object
    Dim i As Long, j As Long
    Dim nameVal As String, dateVal As String, jobVal As String
    Dim rowIdx As Long, colIdx As Long
    Dim repoPath As String, desktopPath As String, csvPath As String
    
    '--- Set sheet ---
    Set ws = ThisWorkbook.Sheets("Sheet1") ' Change if sheet name is different
    
    '--- Find ranges ---
    lastCol = ws.Cells(2, ws.Columns.Count).End(xlToLeft).Column
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row
    Set rngDates = ws.Range(ws.Cells(2, 2), ws.Cells(2, lastCol)) ' Dates in row 2, from col B
    Set rngJobs = ws.Range(ws.Cells(3, 1), ws.Cells(lastRow, 1))  ' Names in col A from row 3
    
    '--- Repo + Desktop paths ---
    repoPath = ThisWorkbook.Path
    desktopPath = Environ("USERPROFILE") & "\Desktop"
    csvPath = "schedule.csv"
    
    '--- Create dictionary ---
    Set dict = CreateObject("Scripting.Dictionary")
    
    '--- Loop through names and dates ---
    For i = 1 To rngJobs.Rows.Count
        nameVal = Trim(rngJobs.Cells(i, 1).Value)
        If nameVal <> "" Then
            If Not dict.exists(nameVal) Then dict.Add nameVal, CreateObject("Scripting.Dictionary")
            
            For j = 1 To rngDates.Columns.Count
                dateVal = CStr(rngDates.Cells(1, j).Value)
                If dateVal <> "" Then
                    rowIdx = rngJobs.Cells(i, 1).Row
                    colIdx = rngDates.Cells(1, j).Column
                    jobVal = Trim(ws.Cells(rowIdx, colIdx).Value)
                    
                    If jobVal <> "" Then
                        If Not dict(nameVal).exists(dateVal) Then
                            dict(nameVal)(dateVal) = jobVal
                        Else
                            dict(nameVal)(dateVal) = dict(nameVal)(dateVal) & "/" & jobVal
                        End If
                    End If
                End If
            Next j
        End If
    Next i
    
    '--- Write CSV to repo and desktop ---
    WriteCSV dict, rngDates, repoPath & "\" & csvPath
    WriteCSV dict, rngDates, desktopPath & "\" & csvPath
    
    '--- Open the desktop CSV for preview ---
    Shell "notepad.exe " & desktopPath & "\" & csvPath, vbNormalFocus
End Sub


Private Sub WriteCSV(dict As Object, rngDates As Range, fullPath As String)
    Dim fso As Object, f As Object
    Dim j As Long
    Dim line As String, dateVal As String
    Dim key As Variant  ' must be Variant for dictionary keys
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set f = fso.CreateTextFile(fullPath, True, False)
    
    '--- Header row ---
    line = "Name"
    For j = 1 To rngDates.Columns.Count
        line = line & "," & rngDates.Cells(1, j).Value
    Next j
    f.WriteLine line
    
    '--- Rows for each person ---
    For Each key In dict.Keys
        line = CStr(key)
        For j = 1 To rngDates.Columns.Count
            dateVal = CStr(rngDates.Cells(1, j).Value)
            If dict(key).exists(dateVal) Then
                line = line & "," & dict(key)(dateVal)
            Else
                line = line & ","
            End If
        Next j
        f.WriteLine line
    Next key
    
    f.Close
End Sub

